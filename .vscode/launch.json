{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug @backend-evolved/auth-svc with Nx",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["nx", "serve", "@backend-evolved/auth-svc"],
            "env": {
                "NODE_OPTIONS": "--inspect=9229"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "skipFiles": ["<node_internals>/**"],
            "sourceMaps": true,
            "outFiles": ["${workspaceFolder}/apps/auth-svc/dist/**/*.(m|c|)js", "!**/node_modules/**"]
        },
