meta {
  name: [Test]
  type: graphql
  seq: 2
}

post {
  url: http://localhost:3036/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  query {
  aliments(source: "") {
    _id
      name
      availablePortions
    }
  }
}

vars:post-response {
  availableAliments: res("data.aliments")
}

script:post-response {
  const aliments = res("data.aliments")
  
}

settings {
  encodeUrl: true
}
