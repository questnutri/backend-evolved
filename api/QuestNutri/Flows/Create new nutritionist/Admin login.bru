meta {
  name: Admin login
  type: http
  seq: 2
}

post {
  url: http://{{GATEWAY_URL}}/auth/login
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  email: admin@questnutri.com
  password: questnutri
}

vars:post-response {
  ADMIN_ACCESS_TOKEN: res("accessToken")
}

settings {
  encodeUrl: true
}
