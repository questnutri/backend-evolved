meta {
  name: Create New Meal
  type: http
  seq: 1
}

post {
  url: http://{{GATEWAY_URL}}/diet/{{createdDiet}}/meal
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Breakfast",
    "hour": "12:00",
    "daysOfWeek": ["Monday"]
  }
}

vars:post-response {
  createdMeal: res("id")
}

settings {
  encodeUrl: true
}
