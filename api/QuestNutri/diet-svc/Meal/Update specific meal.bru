meta {
  name: Update specific meal
  type: http
  seq: 5
}

put {
  url: {{HTTP_PROTOCOL}}://{{GATEWAY_URL}}/diet/{{createdDiet}}/meal/:mealId
  body: json
  auth: bearer
}

params:path {
  mealId: fe433f3b-7c0b-41aa-bf1a-c805c4fd5c86
}

auth:bearer {
  token: {{NUTRITIONIST_ACCESS_TOKEN}}
}

body:json {
  {
    "hour": "15:00"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
